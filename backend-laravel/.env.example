APP_NAME="NeuroTrader Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neurotrader_lab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Legacy BacktestRun/TrainingSession evolution is manual-only by default.
LAB_QUEUE_FAIRNESS_MAX_DEFERRALS=2
LAB_QUEUE_FAIRNESS_RELEASE_SECONDS=300
LAB_QUEUE_MUTEX_RELEASE_SECONDS=60
LAB_REPLAY_MUTEX_KEY=neurotrader-ai-heavy-replay
LAB_FRONTIER_QUEUE=lab-frontier
LAB_FRONTIER_BACKLOG_LIMIT=4

CACHE_STORE=redis
LAB_EVIDENCE_DISK=lab_evidence
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_SERVICE_URL=http://127.0.0.1:9000
AI_SERVICE_DEFAULT_DATASET=../datasets/XAUUSD_H1.csv
AI_SERVICE_BACKTEST_TIMEOUT_SECONDS=900
AI_SERVICE_STRATEGY_LAB_TIMEOUT_SECONDS=2400
# Robustness sub-replays are fail-closed and only run after this core sample
# threshold; keep it aligned with the full-replay admission minimum.
AI_SCREENING_ROBUSTNESS_MIN_TRADES=10
LAB_REPLAY_CACHE_TTL_SECONDS=1209600
LAB_REPLAY_CACHE_MAX_BYTES=2147483648
LAB_REPLAY_CACHE_CLEANUP_INTERVAL_SECONDS=300
# Large foundation archives use a bounded two-candidate replay cohort as an
# infrastructure budget. This does not relax statistical or promotion gates.
LAB_FULL_REPLAY_BOUNDED_COHORT_FOUNDATION_ROWS=100000
LAB_FULL_REPLAY_MAX_COHORT_SIZE=2
# Do not stale-recover a full job while Laravel is still sealing response,
# forward-gate and immutable lifecycle evidence after the Python child exits.
LAB_FULL_REPLAY_POST_PROCESSING_GRACE_SECONDS=900

MARKET_DATA_PROVIDER=twelve
MARKET_DATA_CANONICAL_PROVIDER=twelve
MARKET_DATA_FALLBACK_PROVIDER=
HISTORICAL_MINIMUM_ROWS=5000
HISTORICAL_ALLOWED_MISSING_OPEN_HOURS=0
HISTORICAL_GAP_REPAIR_LIMIT=100
SECONDARY_INTELLIGENCE_ENABLED=false
INTERNAL_API_TOKEN=
SCHEDULER_MEMORY_LIMIT_MB=256
# Set only for a one-time non-interactive auth:create-user run, then remove.
BOOTSTRAP_ADMIN_PASSWORD=
PAPER_OBSERVATION_MIN_DAYS=90
PAPER_OBSERVATION_MIN_SIGNALS=1000
PAPER_OBSERVATION_MIN_CLOSED_TRADES=200
PAPER_OBSERVATION_MIN_REGIMES=3
PAPER_OBSERVATION_MIN_TRADES_PER_REGIME=20
PAPER_OBSERVATION_MIN_PROFIT_FACTOR=1.3
PAPER_OBSERVATION_MAX_DRAWDOWN_PERCENT=15
PAPER_OBSERVATION_MIN_FEED_UPTIME_PERCENT=99.5
PAPER_CALIBRATION_MINIMUM_SAMPLES=20
PAPER_CALIBRATION_MINIMUM_CONFIDENCE=0.55
LAB_MINIMUM_SCREENING_TRADES=10
LAB_ADAPTIVE_PARENT_ENABLED=true
LAB_ADAPTIVE_ARCHIVE_ENABLED=true
LAB_ADAPTIVE_PARENT_SHADOW=false
LAB_ADAPTIVE_BUDGET_ENABLED=true
LAB_ADAPTIVE_CAUSAL_SEAT_FLOOR=8
# Bootstrap caps: robust 3-5 contributors, architecture 2-4 contributors.
# Set 0 only for an intentional operator-run frontier audit.
LAB_PARENT_MAX_ROBUST=5
LAB_PARENT_MAX_ARCHITECTURE=4
LAB_PARENT_MAX_CURIOSITY=2
LAB_PARENT_MAX_RUNTIME=8
LAB_POPULATION_SIZE=20
LAB_POPULATION_MIN_SIZE=1
# 0 = no application-level population ceiling; use a positive value only for
# an explicit infrastructure/compute budget.
LAB_POPULATION_MAX_SIZE=0
LAB_PORTFOLIO_COUNCIL_MAX_NICHES=0
LAB_PORTFOLIO_COUNCIL_SOURCE_LIMIT=0
LAB_FORWARD_FAILURE_SOURCE_LIMIT=0
LAB_EVIDENCE_COMPLEMENT_SOURCE_LIMIT=0
LAB_ROBUSTNESS_MATRIX_FRONTIER_LIMIT=0
LAB_ROBUSTNESS_MATRIX_SOURCE_LIMIT=0
LAB_PARENT_LINEAGE_CAP=0.50
LAB_PARENT_DIVERSITY_WEIGHT=20
LAB_SEMANTIC_CELL_PARENT_FRONTIER=0
LAB_PARENT_CANDIDATE_FRONTIER=0
LAB_ARCHIVE_FAILURE_LIMIT=0
LAB_ARCHIVE_MAX_PER_ISLAND=0
LAB_ARCHIVE_MIGRATION_LIMIT=0
LAB_CONFIRMED_PARENT_TRAITS_LIMIT=0
LAB_MUTATION_SCOPE_SOURCE_LIMIT=0
LAB_SHADOW_VETO_DECISION_LIMIT=0
LAB_GOVERNOR_LOOKBACK_GENERATIONS=3
LAB_GOVERNOR_DIVERSITY_COLLAPSE_THRESHOLD=0.35
LAB_GOVERNOR_STAGNATION_GENERATIONS=3
# A provider key is required. Until configured, the calendar records
# "not_configured" and never claims a live-news veto is active.
ECONOMIC_CALENDAR_ENABLED=false
ECONOMIC_CALENDAR_PROVIDER=financial_modeling_prep
ECONOMIC_CALENDAR_ENDPOINT=https://financialmodelingprep.com/stable/economic-calendar
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENDPOINT=https://www.alphavantage.co/query
ALPHA_VANTAGE_HEADLINE_WINDOW_MINUTES=60
CURRENTS_API_KEY=
CURRENTS_API_ENDPOINT=https://api.currentsapi.services/v1/latest-news
CURRENTS_API_HEADLINE_WINDOW_MINUTES=60
CURRENTS_API_PAGE_SIZE=20
ECONOMIC_CALENDAR_PRE_EVENT_MINUTES=30
ECONOMIC_CALENDAR_POST_EVENT_MINUTES=30
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_TIMEOUT_SECONDS=30
TWELVE_DATA_MAX_OUTPUT_SIZE=5000
TWELVE_DATA_XAUUSD_SYMBOL=XAU/USD
TWELVE_DATA_EURUSD_SYMBOL=EUR/USD
TWELVE_DATA_GBPUSD_SYMBOL=GBP/USD
LIVE_TRADING_ENABLED=false
LIVE_TRADING_HARD_STOP=true
LIVE_KILL_SWITCH_ENGAGED=true
LIVE_HUMAN_APPROVAL_SHA256=
LIVE_MAX_CAPITAL=0
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
DUKASCOPY_NODE_BINARY=node
DUKASCOPY_TRANSPORT=jetta
DUKASCOPY_JETTA_BASE_URL=https://jetta.dukascopy.com
DUKASCOPY_HTTP_TIMEOUT_SECONDS=20
DUKASCOPY_HTTP_RETRY_ATTEMPTS=3
DUKASCOPY_TICK_FALLBACK_ENABLED=true
DUKASCOPY_TIMEOUT_SECONDS=180
DUKASCOPY_BATCH_SIZE=10
DUKASCOPY_PAUSE_MS=250
DUKASCOPY_CHUNK_DAYS=7
DUKASCOPY_LIVE_CHUNK_HOURS=1
DUKASCOPY_EMPTY_RESPONSE_GRACE_MINUTES=15
DUKASCOPY_RETRY_ATTEMPTS=2
DUKASCOPY_XAUUSD_INSTRUMENT=xauusd
DUKASCOPY_EURUSD_INSTRUMENT=eurusd
DUKASCOPY_GBPUSD_INSTRUMENT=gbpusd
MT5_PROVIDER=${MARKET_DATA_PROVIDER}
MT5_TIMEFRAMES=H1
MT5_FEED_STALE_AFTER_SECONDS=7200
MT5_FEED_LOST_AFTER_SECONDS=10800
MARKET_REALITY_ANALYSIS_LIMIT=60
PROMOTION_REQUIRE_ALL_MARKETS_HEALTHY=true
PROMOTION_PAPER_MIN_SAMPLES=50
PROMOTION_FREEZE_CHAMPION=true
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_POSITIONS_PER_GROUP=2
RISK_DAILY_LOSS_LIMIT_PERCENT=2
RISK_MAX_RISK_PER_TRADE_PERCENT=1
RISK_FX_SPREAD_POINTS=12
RISK_XAU_SPREAD_POINTS=35
EXECUTION_FX_SPREAD_POINTS=12
EXECUTION_XAU_SPREAD_POINTS=35
EXECUTION_COMMISSION_PERCENT=0.01
EXECUTION_SLIPPAGE_POINTS=2
EXECUTION_SWAP_PER_DAY_PERCENT=0.002
RISK_SLIPPAGE_POINTS=2

COT_CFTC_ENDPOINT=https://publicreporting.cftc.gov/resource/72hh-3qpy.json
COT_GOLD_MARKET_NAME="GOLD - COMMODITY EXCHANGE INC."
COT_TIMEOUT_SECONDS=30

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
